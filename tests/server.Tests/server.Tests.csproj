<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>server.Tests</RootNamespace>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
		<PackageReference Include="Microsoft.Garnet" Version="2.2.3" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
		<PackageReference Include="StackExchange.Redis" Version="3.4.5" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\server\server.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 与被测项目一致：RSA 私钥用于解密客户端提交的用户名与密码 -->
		<None Include="..\..\server\privkey.key" Link="privkey.key" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
