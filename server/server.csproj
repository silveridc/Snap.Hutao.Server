<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605</WarningsAsErrors>
		<UserSecretsId>f5e9eb75-6632-4266-b3f1-2d363414cbe5</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>
<!-- -->

	<ItemGroup>
		<PackageReference Include="IP2Region.Net" Version="3.0.2" />
		<PackageReference Include="MailKit" Version="4.18.1" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.13" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
		<PackageReference Include="Quartz.AspNetCore" Version="4.6.0" />
		<PackageReference Include="Sentry.AspNetCore" Version="6.12.1" />
		<PackageReference Include="StackExchange.Redis" Version="3.4.5" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.1" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<!-- metadata 落库要算 XXH64；这个包本来就被间接引用带进输出目录，显式写出不依赖传递关系 -->
		<PackageReference Include="System.IO.Hashing" Version="10.0.13" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Resources\Assets\ipv4.xdb">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\Assets\ipv6.xdb">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<None Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Migrations\" />
		<Folder Include="Resources\Assets\" />
	</ItemGroup>
	<ItemGroup>
	  <None Update="privkey.key">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
	<ItemGroup>
	  <EditorConfigFiles Remove="D:\projects\hutao\server\server\.editorconfig" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="D:\projects\hutao\server\server\.editorconfig" />
	</ItemGroup>

</Project>