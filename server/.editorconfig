# 如果要从更高级别的目录继承 .editorconfig 设置，请删除以下行
root = true

# C# 文件
[*.cs]

#### Core EditorConfig 选项 #####
indent_size = 4
indent_style = space
tab_width = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8

#### .NET 代码操作 #####
dotnet_hide_advanced_members = false
dotnet_member_insertion_location = with_other_members_of_the_same_kind
dotnet_property_generation_behavior = prefer_throwing_properties
dotnet_search_reference_assemblies = true

#### .NET 编码约定 #####
# using 放在文件顶部，按字母排序，System.* 置顶
dotnet_separate_import_directive_groups = false:suggestion
dotnet_sort_system_directives_first = true:warning
file_header_template = unset

# 避免使用 this.
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_property = false:suggestion

# 语言关键字 (int, string 代替 Int32, String)
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# 必须显式声明可见性修饰符
dotnet_style_require_accessibility_modifiers = always:warning

# 优先使用 readonly
dotnet_style_readonly_field = true:suggestion

# 严禁多行连续空行
dotnet_style_allow_multiple_blank_lines_experimental = false

#### C# 编码约定 #####

# 【核心要求 3】全场景彻底禁用 var（全部报错并强制显式声明类型）
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error

# 【核心要求 1】强制文件范围命名空间 (namespace Foo;)
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:warning

# 修饰符顺序 (可见性排在最前)
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:warning

# 单行语句与大括号 (跨行必须大括号)
csharp_prefer_braces = when_multiline:warning
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

#### C# 格式规则 #####
# Allman 换行
csharp_new_line_before_open_brace = all
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_before_members_in_object_initializers = true

# 缩进与空行
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# 空格控制
csharp_space_after_cast = false
csharp_space_after_comma = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_around_binary_operators = before_and_after
csharp_space_before_comma = false
csharp_space_between_parentheses = false

#### 命名规范 #####
# 局部变量必须使用 camelCase (不带下划线)
dotnet_naming_rule.locals_should_be_camel_case.severity = warning
dotnet_naming_rule.locals_should_be_camel_case.symbols = locals
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case
dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_symbols.locals.applicable_accessibilities = *
# 1. 接口以 I 开头
dotnet_naming_rule.interface_should_be_begins_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

# 2. 类型使用 PascalCase
dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

# 3. 方法、属性、事件使用 PascalCase
dotnet_naming_rule.members_should_be_pascal_case.severity = warning
dotnet_naming_rule.members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.members_should_be_pascal_case.style = pascal_case
# 4.1 非私有常量必须是 PascalCase (public, internal, protected)
dotnet_naming_rule.public_constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.public_constants_should_be_pascal_case.symbols = public_constants
dotnet_naming_rule.public_constants_should_be_pascal_case.style = pascal_case

# 4.2 私有常量允许并要求使用 _camelCase
dotnet_naming_rule.private_constants_should_have_underscore.severity = warning
dotnet_naming_rule.private_constants_should_have_underscore.symbols = private_constants
dotnet_naming_rule.private_constants_should_have_underscore.style = prefix_underscore_camel_case

# 5. 【核心要求 2】所有 private 字段一律以 _ 开头 (camelCase)
dotnet_naming_rule.private_fields_should_have_underscore.severity = error
dotnet_naming_rule.private_fields_should_have_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_have_underscore.style = prefix_underscore_camel_case

# 6. 非 private 字段（public / protected / internal）使用 PascalCase
dotnet_naming_rule.public_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.public_fields_should_be_pascal_case.symbols = public_and_internal_fields
dotnet_naming_rule.public_fields_should_be_pascal_case.style = pascal_case

# 7. 参数使用标准 camelCase
dotnet_naming_rule.parameters_should_be_camel_case.severity = warning
dotnet_naming_rule.parameters_should_be_camel_case.symbols = parameters
dotnet_naming_rule.parameters_should_be_camel_case.style = camel_case

# --- 符号定义 ---
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = *

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, record
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_symbols.non_field_members.applicable_kinds = method, local_function, property, event
dotnet_naming_symbols.non_field_members.applicable_accessibilities = *

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.constants.applicable_accessibilities = *

# 包含所有 private / private_protected 字段（无论是实例字段还是静态字段，但不包含 const）
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected

dotnet_naming_symbols.public_and_internal_fields.applicable_kinds = field
dotnet_naming_symbols.public_and_internal_fields.applicable_accessibilities = public, internal, protected, protected_internal

dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.parameters.applicable_accessibilities = *

# --- 样式定义 ---
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_style.prefix_underscore_camel_case.required_prefix = _
dotnet_naming_style.prefix_underscore_camel_case.capitalization = camel_case
dotnet_diagnostic.SA1300.severity = none
#### StyleCop.Analyzers 抑制规则 #####
# 允许字段带下划线（SA1309 默认禁止下划线，必须关闭）
dotnet_diagnostic.SA1309.severity = none
# 允许常量 PascalCase
dotnet_diagnostic.SA1303.severity = none
# 允许 discard 参数为 _
dotnet_diagnostic.SA1313.severity = none
# 不写 this.
dotnet_diagnostic.SA1101.severity = none
# 允许无文件头注释
dotnet_diagnostic.SA1633.severity = none
# 忽略未注释警告
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1404.severity = none
dotnet_diagnostic.SA1515.severity = none
# EF Core 迁移目录跳过风格检查

# IDE1006: 命名样式
dotnet_diagnostic.IDE1006.severity = none

[Migrations/*.cs]
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none